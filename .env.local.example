# Quartzy local full-stack environment variables (Windows host + local PostgreSQL)
# Copy this file to `.env.local` in the repository root and update the values.

# Backend
DEBUG=True
USE_POSTGRES=True
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=cellstorage_user
DB_PASS=replace_with_real_password
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8000

